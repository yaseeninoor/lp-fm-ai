rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn() && request.auth.token.role is string ? request.auth.token.role :
        (signedIn() && request.auth.token.superadmin == true ? 'superadmin' :
        (signedIn() && request.auth.token.admin == true ? 'admin' : 'user'));
    }
    function isAdmin() { return role() in ['admin', 'superadmin']; }
    function isSuperAdmin() { return role() == 'superadmin'; }
    function notBlocked() { return signedIn() && (isAdmin() || !exists(/databases/$(database)/documents/chatBlocks/$(request.auth.uid))); }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(['uid','fullName','phone','email','role','createdAt','updatedAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 2
        && request.resource.data.phone is string && request.resource.data.email == request.auth.token.email;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','phone','updatedAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 2
        && request.resource.data.phone is string;
      allow update, delete: if isSuperAdmin();
    }

    match /chatProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','username','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2
        && (!('username' in request.resource.data) ||
          (request.resource.data.username is string && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')));
      allow delete: if isSuperAdmin();
    }

    match /usernames/{handle} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/usernames/$(handle))
        && request.resource.data.keys().hasOnly(['uid','username','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == handle
        && handle.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /chatBlocks/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() && request.resource.data.uid == uid && request.resource.data.blockedBy == request.auth.uid;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /communityMessages/{messageId} {
      allow read: if signedIn();
      allow create: if notBlocked() && isAdmin()
        && request.resource.data.keys().hasOnly(['uid','name','text','readBy','createdAt','attachmentUrl','attachmentName','attachmentType','contact'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.readBy is list && request.auth.uid in request.resource.data.readBy
        && (request.resource.data.text.size() > 0 || ('attachmentUrl' in request.resource.data) || ('contact' in request.resource.data))
        && (!('attachmentUrl' in request.resource.data) ||
          (request.resource.data.attachmentUrl is string && request.resource.data.attachmentName is string && request.resource.data.attachmentType is string));
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /conversations/{conversationId} {
      function isParticipant() { return signedIn() && request.auth.uid in resource.data.participants; }
      allow create: if notBlocked() && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants;
      allow read: if isParticipant() || isAdmin();
      allow update: if isParticipant() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessage','lastMessageAt','lastSenderId']) && (!('lastSenderId' in request.resource.data) || request.resource.data.lastSenderId == request.auth.uid);
      allow delete: if isAdmin();
      match /messages/{messageId} {
        function parentParticipants() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if (signedIn() && request.auth.uid in parentParticipants()) || isAdmin();
        allow create: if notBlocked() && signedIn() && request.auth.uid in parentParticipants()
          && request.resource.data.uid == request.auth.uid && request.resource.data.name is string
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0 || ('attachmentUrl' in request.resource.data) || ('contact' in request.resource.data))
          && request.resource.data.keys().hasOnly(['uid','name','text','readBy','createdAt','attachmentUrl','attachmentName','attachmentType','contact'])
        && request.resource.data.readBy is list && request.auth.uid in request.resource.data.readBy
          && (!('contact' in request.resource.data) || (request.resource.data.contact is map && request.resource.data.contact.name is string && request.resource.data.contact.phone is string));
        allow delete: if isAdmin();
        allow update: if signedIn() && request.auth.uid in parentParticipants() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) && request.resource.data.readBy is list && request.auth.uid in request.resource.data.readBy;
      }
    }

    match /userStatuses/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid && request.resource.data.name is string
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.keys().hasOnly(['uid','name','text','createdAt','expiresAt']);
      allow delete: if signedIn() && request.auth.uid == uid;
      match /views/{viewerUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == viewerUid && viewerUid != uid
          && request.resource.data.uid == viewerUid && request.resource.data.name is string;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /channelPosts/{postId} {
      allow read: if signedIn() && resource.data.published == true;
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.title is string && request.resource.data.title.size() <= 160
        && request.resource.data.body is string && request.resource.data.body.size() <= 10000
        && request.resource.data.authorName is string
        && request.resource.data.likes is list && request.resource.data.likes.size() == 0
        && request.resource.data.keys().hasOnly(['title','body','mediaUrl','mediaName','mediaType','authorName','createdBy','published','likes','createdAt']);
      allow update: if (isAdmin() && request.resource.data.createdBy == resource.data.createdBy)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is list
          && ((request.resource.data.likes.size() == resource.data.likes.size() + 1
                && request.auth.uid in request.resource.data.likes
                && !(request.auth.uid in resource.data.likes))
            || (request.resource.data.likes.size() == resource.data.likes.size() - 1
                && !(request.auth.uid in request.resource.data.likes)
                && request.auth.uid in resource.data.likes)));
      allow delete: if isAdmin();
    }
    match /noorPosts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /noorContent/{contentId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.published == true && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 180
        && request.resource.data.type in ['pdf', 'text', 'image', 'youtube'];
      allow update: if isAdmin() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}