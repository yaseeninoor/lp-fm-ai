rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() && request.auth.token.role is string ? request.auth.token.role : (signedIn() && request.auth.token.superadmin == true ? 'superadmin' : (signedIn() && request.auth.token.admin == true ? 'admin' : 'user')); }
    function isAdmin() { return role() in ['admin', 'superadmin']; }
    match /noor-portal-media/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isAdmin() && request.auth.uid == uid
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('(audio|video|image)/.*|application/pdf|application/(msword|vnd.openxmlformats-officedocument.*)|text/plain');
    }
    match /noor-chat-media/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|video|audio)/.*|application/pdf|application/(msword|vnd.openxmlformats-officedocument.*|vnd.ms-.*)|text/plain|text/vcard|text/x-vcard|application/octet-stream');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}